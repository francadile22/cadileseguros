# ─────────────────────────────────────────────────────────────
# Estudio Cadile — variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# En Vercel, cargalas en Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# CHATBOT (API de Anthropic / Claude). NUNCA exponer en el cliente.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo del chat. Por defecto: claude-haiku-4-5-20251001 (rápido y económico).
# Para respuestas más elaboradas podés usar claude-sonnet-4-6.
CHAT_MODEL=claude-haiku-4-5-20251001

# LEADS / FORMULARIOS (email vía Resend). Opcional pero recomendado.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado en Resend (o usá onboarding@resend.dev para probar).
LEAD_FROM_EMAIL="Estudio Cadile <hola@tudominio.com.ar>"
# Dónde recibís las solicitudes (por defecto, el email del negocio).
LEAD_TO_EMAIL=cadile.contacto@gmail.com

# WEBHOOK opcional para CRM / n8n / Routine (recibe cada lead en JSON).
# LEAD_WEBHOOK_URL=https://tu-webhook.example.com/leads
